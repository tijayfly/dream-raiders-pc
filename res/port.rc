#include <winver.h>
#include "../src/version.h"

1 ICON "res/DreamRaiders.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     PORT_VERSION_MAJOR, PORT_VERSION_MINOR, PORT_VERSION_PATCH, 0
PRODUCTVERSION  PORT_VERSION_MAJOR, PORT_VERSION_MINOR, PORT_VERSION_PATCH, 0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Dream Raiders PC port"
      VALUE "FileVersion", PORT_VERSION_STR
      VALUE "ProductName", "Dream Raiders PC port"
      VALUE "ProductVersion", PORT_VERSION_STR
      VALUE "OriginalFilename", "d3d9.dll"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
